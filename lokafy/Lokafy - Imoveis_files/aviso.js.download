(() => {
  const TOAST_DURATION = 4800;
  const TOAST_DEDUP_MS = 1200;
  const validTypes = ["success", "error", "warning"];
  let lastToastKey = "";
  let lastToastTime = 0;

  function getContainer() {
    let container = document.getElementById("toast-container");
    if (!container) {
      container = document.createElement("div");
      container.id = "toast-container";
      document.body.appendChild(container);
    }
    return container;
  }

  function getIconByType(type) {
    if (type === "success") return "✓";
    if (type === "error") return "✕";
    return "!";
  }

  function criarToast(msg, tipo = "success") {
    const text = String(msg ?? "").trim();
    if (!text) return;

    if (!validTypes.includes(tipo)) {
      tipo = "success";
    }

    const now = Date.now();
    const key = `${tipo}:${text}`;
    if (key === lastToastKey && now - lastToastTime < TOAST_DEDUP_MS) {
      return;
    }
    lastToastKey = key;
    lastToastTime = now;

    const container = getContainer();
    const toast = document.createElement("div");
    toast.className = `toast ${tipo}`;
    toast.setAttribute("role", "status");
    toast.setAttribute("aria-live", "polite");

    const inner = document.createElement("div");
    inner.className = "toast-inner";

    const icon = document.createElement("span");
    icon.className = "toast-icon";
    icon.textContent = getIconByType(tipo);
    icon.setAttribute("aria-hidden", "true");

    const message = document.createElement("span");
    message.className = "toast-message";
    message.textContent = text;

    const close = document.createElement("button");
    close.type = "button";
    close.className = "toast-close";
    close.setAttribute("aria-label", "Fechar aviso");
    close.innerHTML = "&times;";

    inner.appendChild(icon);
    inner.appendChild(message);
    inner.appendChild(close);
    toast.appendChild(inner);
    container.appendChild(toast);

    const removeToast = () => {
      if (toast.parentNode) toast.remove();
    };

    const timer = setTimeout(removeToast, TOAST_DURATION);
    close.addEventListener("click", () => {
      clearTimeout(timer);
      removeToast();
    });
  }

  window.criarToast = criarToast;
  window.toastSuccess = (msg) => criarToast(msg, "success");
  window.toastError = (msg) => criarToast(msg, "error");
  window.toastWarning = (msg) => criarToast(msg, "warning");
})();
