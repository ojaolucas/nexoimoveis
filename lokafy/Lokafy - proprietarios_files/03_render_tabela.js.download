function renderizarTabelaProprietarios(lista) {
  const tbody = document.getElementById('tabelaProprietarios');
  const vazioTitulo = document.getElementById('estadoVazioTitulo');
  const vazioTexto = document.getElementById('estadoVazioTexto');
  const state = window.proprietariosTabelaState;
  if (!tbody || !state) return;

  state.listaFiltrada = Array.isArray(lista) ? lista : [];
  tbody.innerHTML = '';

  if (!state.listaFiltrada.length) {
    renderizarEstadoVazioProprietarios(tbody, vazioTitulo, vazioTexto);
    atualizarPaginacaoProprietarios(0, 0, 0);
    return;
  }

  const total = state.listaFiltrada.length;
  const totalPaginas = Math.max(1, Math.ceil(total / state.itensPorPagina));
  if (state.paginaAtual > totalPaginas) state.paginaAtual = totalPaginas;
  if (state.paginaAtual < 1) state.paginaAtual = 1;

  const inicio = (state.paginaAtual - 1) * state.itensPorPagina;
  const fim = inicio + state.itensPorPagina;
  const listaPaginada = state.listaFiltrada.slice(inicio, fim);

  tbody.innerHTML = listaPaginada.map(renderizarLinhaProprietario).join('');
  atualizarPaginacaoProprietarios(inicio + 1, Math.min(fim, total), total);
}

function renderizarEstadoVazioProprietarios(tbody, vazioTitulo, vazioTexto) {
  const state = window.proprietariosTabelaState;
  const busca = (document.getElementById('filtroBusca')?.value || '').trim();
  const filtroImovel = (document.getElementById('filtroImovel')?.value || '').trim();
  const filtroContrato = (document.getElementById('filtroContrato')?.value || '').trim();
  const semCadastro = state.listaOriginal.length === 0;
  const temFiltroAtivo = !!(busca || filtroImovel || filtroContrato);
  const titulo = semCadastro ? 'Nenhum proprietário cadastrado' : 'Nenhum proprietário encontrado';
  const texto = semCadastro
    ? 'Use o botão <strong>Novo proprietário</strong> para começar.'
    : (temFiltroAtivo ? 'Tente ajustar os filtros para encontrar resultados.' : 'Não há dados para exibir no momento.');

  if (vazioTitulo) vazioTitulo.textContent = titulo;
  if (vazioTexto) vazioTexto.innerHTML = texto;
  tbody.innerHTML = `<tr class="empty-state-row"><td colspan="7"><div class="table-empty table-empty-inline"><span class="empty-icon"><i class="fa-regular fa-address-book"></i></span><h4>${titulo}</h4><p>${texto}</p></div></td></tr>`;
}

function renderizarLinhaProprietario(p) {
  const nomeFmt = p.nome || 'Não informado';
  const telefoneFmt = maskTelefoneExibicao(p.telefone);
  const emailFmt = formatEmail(p.email);
  const rgBase = formatRG(p.rg_numero);
  const rgFormatado = rgBase !== 'Não informado' && p.rg_orgao && p.rg_uf ? `${rgBase} ${p.rg_orgao}/${p.rg_uf}` : rgBase;
  const totalImoveis = Number(p.total_imoveis || 0);
  const totalContratos = Number(p.total_contratos || 0);
  const labelImoveis = totalImoveis === 1 ? 'imóvel' : 'imóveis';
  const labelContratos = totalContratos === 1 ? 'contrato' : 'contratos';
  const docPrincipalValor = (p.cpf_cnpj || '-').trim() || '-';
  const docPrincipalMascara = maskCpfCnpj(docPrincipalValor);
  const docTipo = String(p.cpf_cnpj_tipo || '').toLowerCase();
  const docPrincipalLabel = docTipo === 'cnpj' ? 'CNPJ:' : docTipo === 'cpf' ? 'CPF:' : 'Documento:';
  const razaoSocial = String(p.razao_social || '').trim();
  const representanteNome = String(p.representante_legal_nome || '').trim();
  const representanteCpfRaw = String(p.representante_legal_cpf || '').trim();
  const representanteCpf = representanteCpfRaw ? maskCpfCnpj(representanteCpfRaw) : '';
  const representanteCargo = String(p.representante_legal_cargo || '').trim();
  const temRepresentante = !!(representanteNome || representanteCpfRaw || representanteCargo);

  return `
    <tr>
      <td data-label="#" class="fx-id">${escapeHtml(p.id)}</td>
      <td data-label="Nome" class="fx-nome">
        <div class="prop-nome-stack" title="${escapeHtml(nomeFmt)}">
          <i class="fa-regular fa-user prop-nome-icon"></i>
          <div class="prop-nome-content">
            <span class="fx-main">${escapeHtml(nomeFmt)}</span>
            ${razaoSocial ? `<span class="prop-nome-extra">Razão social: ${escapeHtml(razaoSocial)}</span>` : ''}
            ${temRepresentante ? `<span class="prop-nome-extra">Representante: ${escapeHtml(representanteNome || '-')}${representanteCpf ? ` • ${escapeHtml(representanteCpf)}` : ''}${representanteCargo ? ` • ${escapeHtml(representanteCargo)}` : ''}</span>` : ''}
          </div>
        </div>
      </td>
      <td data-label="Telefone / E-mail" class="fx-telefone"><div class="prop-tel-stack" title="${escapeHtml(`${telefoneFmt} • ${emailFmt}`)}"><div class="prop-tel-content"><span class="prop-tel-row"><i class="fa-solid fa-phone prop-tel-icon"></i><span class="prop-tel-value">${escapeHtml(telefoneFmt)}</span></span><span class="prop-tel-row"><i class="fa-regular fa-envelope prop-tel-icon"></i><span class="prop-tel-email">${escapeHtml(emailFmt)}</span></span></div></div></td>
      <td data-label="Documentos" class="fx-documentos"><div class="prop-doc-list"><span class="prop-doc-item"><i class="fa-regular fa-id-card prop-doc-icon"></i><span class="prop-doc-label">${docPrincipalLabel}</span><span class="prop-doc-value">${escapeHtml(docPrincipalMascara)}</span></span><span class="prop-doc-item"><i class="fa-regular fa-address-card prop-doc-icon"></i><span class="prop-doc-label">RG:</span><span class="prop-doc-value">${escapeHtml(rgFormatado)}</span></span></div></td>
      <td data-label="Imóveis" class="fx-imoveis"><div class="prop-relacao-stack">${renderizarBotaoImoveisProprietario(p, totalImoveis, labelImoveis)}</div></td>
      <td data-label="Contratos" class="fx-contratos"><div class="prop-relacao-stack">${renderizarBotaoContratosProprietario(p, totalContratos, labelContratos)}</div></td>
      <td class="fx-acoes">${renderizarAcoesProprietario(p.id)}</td>
    </tr>
  `;
}

function renderizarBotaoImoveisProprietario(p, totalImoveis, labelImoveis) {
  if (totalImoveis <= 0) return '<span class="prop-chip-empty">Sem imóveis</span>';
  return `<button class="imoveis-link btn-ver-imoveis" data-id="${escapeHtml(p.id)}" data-nome="${escapeHtml(p.nome)}"><i class="fa-regular fa-building"></i><span class="imoveis-link-text">${totalImoveis} ${labelImoveis}</span></button>`;
}

function renderizarBotaoContratosProprietario(p, totalContratos, labelContratos) {
  if (totalContratos <= 0) return '<span class="prop-chip-empty">Sem contratos</span>';
  return `<button class="imoveis-link btn-ver-contratos" data-id="${escapeHtml(p.id)}" data-nome="${escapeHtml(p.nome)}"><i class="fa-regular fa-file-lines"></i><span class="imoveis-link-text">${totalContratos} ${labelContratos}</span></button>`;
}

function renderizarAcoesProprietario(id) {
  return `<div class="actions-menu"><button class="btn-more" type="button" aria-label="Ações do proprietário"><i class="fa-solid fa-ellipsis-vertical"></i></button><div class="dropdown"><button type="button" class="btn-editar-proprietario" data-id="${escapeHtml(id)}">Editar</button><button type="button" class="danger btn-excluir-proprietario" data-id="${escapeHtml(id)}">Excluir</button></div></div>`;
}

window.renderizarTabelaProprietarios = renderizarTabelaProprietarios;
